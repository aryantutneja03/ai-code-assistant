# Copy to .env and fill in any of the following to enable real providers.
# Leave them unset to run fully offline with local fallbacks.

# OpenAI: enables text-embedding-3 embeddings + GPT-4o generation
OPENAI_API_KEY=
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# pgvector: enables Postgres-backed vector storage
DATABASE_URL=

# Retrieval tuning
TOP_K=4
SEMANTIC_CACHE_THRESHOLD=0.95
